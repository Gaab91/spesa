rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni famiglia ha le sue liste sotto /families/<codice-famiglia>/lists.
    // Serve l'accesso anonimo dell'app e il codice (16 caratteri + trattini) nel percorso.
    // Non esiste nessuna regola che permetta di elencare le famiglie.
    match /families/{code}/lists/{listId} {
      allow read, write: if request.auth != null && code.size() >= 16;
    }
  }
}
